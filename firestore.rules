rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own profile; admins can read/write all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == "ADMIN");
      allow write: if false; // Only backend (Admin SDK) writes user docs
    }

    // Snapshots: authenticated users can create; visibility scoped by geo claims
    match /snapshots/{snapId} {
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        request.auth.token.role == "ADMIN" ||
        request.auth.token.level == "NATIONAL" ||
        (request.auth.token.level == "STATE"    && resource.data.state    == request.auth.token.geoState) ||
        (request.auth.token.level == "DISTRICT" && resource.data.state    == request.auth.token.geoState
                                                && resource.data.district == request.auth.token.geoDistrict) ||
        (request.auth.token.level == "BLOCK"    && resource.data.state    == request.auth.token.geoState
                                                && resource.data.district == request.auth.token.geoDistrict) ||
        resource.data.userId == request.auth.uid
      );
      allow update: if false; // Snapshots are immutable
    }

    // Geo entries: any authenticated user can read; only backend writes
    match /geoEntries/{entryId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend (Admin SDK) writes geo entries
    }
  }
}
