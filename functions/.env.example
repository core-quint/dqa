# Copy this file to .env for local development
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
CORS_ORIGINS=http://localhost:5173

# Optional Vertex AI editorial narrative. Keep disabled until Vertex AI API and IAM are configured.
UWIN_STATE_AI_ENABLED=false
UWIN_STATE_AI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_LOCATION=global

# Hard application limits in addition to Google Cloud billing budgets.
UWIN_STATE_AI_DAILY_USER_LIMIT=10
UWIN_STATE_AI_MONTHLY_LIMIT=500

# FIRESTORE works without provisioning a Cloud Storage bucket. Set GCS only after a bucket exists.
UWIN_STATE_REPORT_STORAGE=FIRESTORE
